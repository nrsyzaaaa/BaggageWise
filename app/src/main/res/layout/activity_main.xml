
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/navy"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <!-- APP LOGO -->
            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="BaggageWise Logo"
                android:scaleType="fitCenter" />

            <!-- APP NAME AND TAGLINE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BaggageWise"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Calculate Smart. Travel Easy."
                    android:textSize="10sp"
                    android:textColor="@color/white" />

            </LinearLayout>

            <!-- SHARE ICON -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                android:tint="@color/gold"
                android:padding="10dp"
                android:contentDescription="Share BaggageWise"
                android:scaleType="fitCenter" />

        </LinearLayout>
        <!-- END HEADER -->


        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Smart. Travel Easy."
                android:textColor="@color/navy"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Calculate your excess baggage fee easily before travelling."
                android:textColor="@color/grey"
                android:textSize="14sp" />


            <!-- HOW TO USE HIGHLIGHT BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:padding="16dp"
                android:background="@drawable/how_to_use_box">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HOW TO USE BAGGAGEWISE"
                    android:textColor="@color/gold"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="01   Enter your baggage weight in kilograms (kg)."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="02   Select your ticket class (Economy or Business)."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="03   Enter the excess baggage rate (RM/kg)."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="04   Tap Calculate Fee to view your result."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="05   Tap Reset to start a new calculation."
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>
            <!-- END HOW TO USE -->


            <!-- INPUT SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Baggage Information"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Baggage Weight (kg)"
                android:textColor="@color/text_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/navy"
                android:hint="Enter baggage weight"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/grey" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ticket Class"
                android:textColor="@color/text_dark"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerClass"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/navy"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Excess Baggage Rate (RM/kg)"
                android:textColor="@color/text_dark"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/navy"
                android:hint="Enter rate per kg"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/grey" />

            <!-- ERROR MESSAGE -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/red"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/navy"
                    android:text="Calculate"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="@color/gold"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="@color/navy" />

            </LinearLayout>


            <!-- RESULT SECTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Calculation Result"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvExcessWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Weight: -- kg"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvCharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Excess Charge: RM --"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/grey" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Payable: RM --"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ABOUT BUTTON -->
            <Button
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/navy_light"
                android:text="About BaggageWise"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>
        <!-- END MAIN CONTENT -->

    </LinearLayout>
</ScrollView>
